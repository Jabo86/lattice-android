import React, { useEffect, useState, useCallback } from "react";
import { View, Text, TextInput, TouchableOpacity, FlatList, ActivityIndicator, Alert, Modal, StyleSheet, RefreshControl, Share } from "react-native";
import { useSafeAreaInsets } from "react-native-safe-area-context";
import * as api from "../lib/api";
import { useI18n } from "../lib/i18n";
import { theme } from "../theme";

const CONTRACTS = ["Full-time", "Part-time", "Contratto", "Stage", "Freelance"];

export default function JobsScreen() {
  const insets = useSafeAreaInsets();
  const { t } = useI18n();
  const [jobs, setJobs] = useState([]);
  const [loading, setLoading] = useState(true);
  const [compose, setCompose] = useState(false);

  const load = useCallback(() => {
    api.jobsList().then((d) => setJobs(Array.isArray(d) ? d : (d?.jobs || []))).catch(() => {}).finally(() => setLoading(false));
  }, []);
  useEffect(() => { load(); const t = setInterval(load, 20000); return () => clearInterval(t); }, [load]);

  const del = (id) => Alert.alert("Elimina annuncio", "Sei sicuro?", [{ text: "Annulla" }, { text: "Elimina", style: "destructive", onPress: async () => { try { await api.jobDelete(id); load(); } catch {} } }]);
  const share = async (item) => {
    const parts = [];
    parts.push(`💼 ${item.title}${item.contract_type ? " · " + item.contract_type : ""}`);
    if (item.position) parts.push(item.position);
    if (item.location) parts.push(`📍 ${item.location}`);
    if (item.description) parts.push(item.description);
    parts.push(`— ${item.company_name || ""}`.trim());
    parts.push("Annuncio da Lattice Lavoro · https://lattice-network.it");
    try { await Share.share({ message: parts.filter(Boolean).join("\n\n") }); } catch {}
  };

  const renderItem = ({ item }) => (
    <View style={s.card} testID="job-card">
      <View style={s.head}>
        <View style={{ flex: 1 }}>
          <Text style={s.title}>{item.title}</Text>
          <Text style={s.company}>{item.company_name || "—"}{item.federated ? "  " + t("net") : ""}</Text>
        </View>
        {item.can_delete && <TouchableOpacity onPress={() => del(item.id)}><Text style={s.del}>🗑</Text></TouchableOpacity>}
      </View>
      <View style={s.meta}>
        {!!item.contract_type && <Text style={s.tag}>{item.contract_type}</Text>}
        {!!item.location && <Text style={s.loc}>📍 {item.location}</Text>}
        {!!item.position && <Text style={s.loc}>{item.position}</Text>}
      </View>
      {!!item.description && <Text style={s.desc}>{item.description}</Text>}
      <View style={s.actions}>
        <TouchableOpacity onPress={() => share(item)} style={s.shareBtn} testID="job-share">
          <Text style={s.shareText}>{t("jobs.share")}</Text>
        </TouchableOpacity>
      </View>
    </View>
  );

  return (
    <View style={{ flex: 1, backgroundColor: "transparent" }}>
      <View style={[s.topBar, { paddingTop: insets.top + 12 }]}>
        <Text style={s.h1}>{t("jobs.title")}</Text>
        <TouchableOpacity onPress={() => setCompose(true)} style={s.newBtn} testID="job-new"><Text style={s.newText}>+ {t("jobs.publish")}</Text></TouchableOpacity>
      </View>
      {loading ? <View style={s.center}><ActivityIndicator color={theme.primary} /></View> : (
        <FlatList
          data={jobs}
          keyExtractor={(j, i) => String(j.id || i)}
          renderItem={renderItem}
          contentContainerStyle={{ padding: 14, paddingBottom: 30 }}
          refreshControl={<RefreshControl refreshing={false} onRefresh={load} tintColor={theme.primary} />}
          ListEmptyComponent={<View style={s.center}><Text style={s.empty}>{t("jobs.empty")}</Text></View>}
        />
      )}
      <JobModal visible={compose} onClose={() => setCompose(false)} onDone={() => { setCompose(false); load(); }} />
    </View>
  );
}

function JobModal({ visible, onClose, onDone }) {
  const { t } = useI18n();
  const [f, setF] = useState({ title: "", position: "", location: "", contract_type: "Full-time", description: "" });
  const [busy, setBusy] = useState(false);
  const submit = async () => {
    if (!f.title.trim() || !f.description.trim()) { Alert.alert(t("att.error"), t("jobs.field.title") + " + " + t("jobs.field.desc")); return; }
    setBusy(true);
    try { await api.jobCreate(f); setF({ title: "", position: "", location: "", contract_type: "Full-time", description: "" }); onDone(); }
    catch (e) { Alert.alert(t("att.error"), api.apiErr(e)); } finally { setBusy(false); }
  };
  return (
    <Modal visible={visible} animationType="slide" transparent onRequestClose={onClose}>
      <View style={s.modalWrap}>
        <View style={s.modalCard}>
          <Text style={s.modalTitle}>{t("jobs.new.title")}</Text>
          <TextInput value={f.title} onChangeText={(v) => setF({ ...f, title: v })} placeholder={t("jobs.field.title") + " *"} placeholderTextColor={theme.textFaint} style={s.mInput} />
          <TextInput value={f.position} onChangeText={(v) => setF({ ...f, position: v })} placeholder={t("jobs.field.type")} placeholderTextColor={theme.textFaint} style={s.mInput} />
          <TextInput value={f.location} onChangeText={(v) => setF({ ...f, location: v })} placeholder={t("jobs.field.location")} placeholderTextColor={theme.textFaint} style={s.mInput} />
          <View style={s.chips}>
            {CONTRACTS.map((c) => (
              <TouchableOpacity key={c} onPress={() => setF({ ...f, contract_type: c })} style={[s.chip, f.contract_type === c && { backgroundColor: theme.primary, borderColor: theme.primary }]}>
                <Text style={{ color: f.contract_type === c ? "#fff" : theme.textDim, fontSize: 12 }}>{c}</Text>
              </TouchableOpacity>
            ))}
          </View>
          <TextInput value={f.description} onChangeText={(v) => setF({ ...f, description: v })} placeholder={t("jobs.field.desc") + " *"} placeholderTextColor={theme.textFaint} style={[s.mInput, { height: 100, textAlignVertical: "top", marginTop: 8 }]} multiline />
          <View style={{ flexDirection: "row", gap: 10, marginTop: 14 }}>
            <TouchableOpacity onPress={onClose} style={[s.mBtn, { backgroundColor: theme.surfaceAlt }]}><Text style={{ color: theme.textDim, fontWeight: "700" }}>{t("cancel")}</Text></TouchableOpacity>
            <TouchableOpacity onPress={submit} disabled={busy} style={[s.mBtn, { backgroundColor: theme.primary }]}>{busy ? <ActivityIndicator color="#fff" /> : <Text style={{ color: "#fff", fontWeight: "700" }}>{t("jobs.publish")}</Text>}</TouchableOpacity>
          </View>
        </View>
      </View>
    </Modal>
  );
}

const s = StyleSheet.create({
  topBar: { flexDirection: "row", alignItems: "center", justifyContent: "space-between", paddingHorizontal: 18, paddingBottom: 12, borderBottomWidth: 1, borderBottomColor: theme.border, backgroundColor: theme.surface },
  h1: { color: theme.text, fontSize: 22, fontWeight: "900" },
  newBtn: { backgroundColor: theme.primary, borderRadius: 20, paddingHorizontal: 16, paddingVertical: 8 },
  newText: { color: "#fff", fontWeight: "700", fontSize: 13 },
  center: { flex: 1, alignItems: "center", justifyContent: "center", padding: 40 },
  empty: { color: theme.textDim, textAlign: "center" },
  card: { backgroundColor: theme.surface, borderWidth: 1, borderColor: theme.border, borderRadius: 14, padding: 14, marginBottom: 12 },
  head: { flexDirection: "row", alignItems: "flex-start" },
  title: { color: theme.text, fontWeight: "800", fontSize: 17 },
  company: { color: "#50C878", fontSize: 11, textTransform: "uppercase", letterSpacing: 1, marginTop: 2 },
  del: { fontSize: 16 },
  meta: { flexDirection: "row", flexWrap: "wrap", gap: 10, marginTop: 8, alignItems: "center" },
  tag: { color: "#9dc0ff", backgroundColor: "rgba(80,200,120,0.12)", borderRadius: 6, paddingHorizontal: 8, paddingVertical: 3, fontSize: 11, fontWeight: "700" },
  loc: { color: theme.textFaint, fontSize: 12 },
  desc: { color: theme.textDim, fontSize: 14, lineHeight: 20, marginTop: 10 },
  actions: { flexDirection: "row", marginTop: 12, borderTopWidth: 1, borderTopColor: theme.border, paddingTop: 10 },
  shareBtn: { paddingVertical: 2 },
  shareText: { color: theme.primary, fontSize: 13, fontWeight: "700" },
  modalWrap: { flex: 1, backgroundColor: "rgba(0,0,0,0.6)", justifyContent: "flex-end" },
  modalCard: { backgroundColor: theme.surface, borderTopLeftRadius: 20, borderTopRightRadius: 20, padding: 20, paddingBottom: 34 },
  modalTitle: { color: theme.text, fontSize: 18, fontWeight: "800", marginBottom: 14 },
  mInput: { backgroundColor: theme.surfaceAlt, borderWidth: 1, borderColor: theme.border, borderRadius: 10, color: theme.text, paddingHorizontal: 14, paddingVertical: 11, fontSize: 15, marginBottom: 8 },
  chips: { flexDirection: "row", flexWrap: "wrap", gap: 8, marginTop: 4 },
  chip: { borderWidth: 1, borderColor: theme.border, borderRadius: 16, paddingHorizontal: 12, paddingVertical: 6 },
  mBtn: { flex: 1, borderRadius: 12, paddingVertical: 14, alignItems: "center" },
});
